# Development Dockerfile with hot-reload support
FROM node:22-alpine

WORKDIR /app

# Install pnpm
RUN npm install -g pnpm@9

# Copy package files
COPY package.json pnpm-lock.yaml ./

# Install dependencies
RUN pnpm install

# Copy application source
COPY . .

# Expose port
EXPOSE 3000

# Development mode with hot reload
CMD ["pnpm", "dev"]
